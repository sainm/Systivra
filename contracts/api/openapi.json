  "components": {
    "schemas": {
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "actor_type",
          "actor_id",
          "action",
          "result",
          "detail",
          "occurred_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "actor_type": {
            "type": "string"
          },
          "detail": {},
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuditListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          }
        }
      },
      "ChunkId": {
        "type": "string",
        "format": "uuid",
        "description": "検索単位の chunk。"
      },
      "ChunkNeighbors": {
        "type": "object",
        "required": [
          "prev",
          "next"
        ],
        "properties": {
          "next": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChunkId"
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "prev": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChunkId"
            }
          }
        }
      },
      "ChunkResponse": {
        "type": "object",
        "required": [
          "chunk_id",
          "chunk_type",
          "text",
          "locator",
          "token_count",
          "char_count",
          "neighbors",
          "parse_run"
        ],
        "properties": {
          "char_count": {
            "type": "integer",
            "format": "int64"
          },
          "chunk_id": {
            "$ref": "#/components/schemas/ChunkId"
          },
          "chunk_type": {
            "type": "string"
          },
          "locator": {},
          "neighbors": {
            "$ref": "#/components/schemas/ChunkNeighbors"
          },
          "parse_run": {
            "$ref": "#/components/schemas/ParseRunRef"
          },
          "text": {
            "type": "string"
          },
          "token_count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DocType": {
        "type": "string",
        "enum": [
          "REQUIREMENT",
          "BASIC_DESIGN",
          "DETAILED_DESIGN",
          "UI_SPEC",
          "DB_SPEC",
          "TEST_SPEC",
          "API_SPEC",
          "MANUAL",
          "OTHER"
        ]
      },
      "DocumentDetail": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "doc_type",
          "title",
          "acl_groups",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "acl_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "current_revision": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RevisionSummary"
              }
            ]
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "id": {
            "$ref": "#/components/schemas/DocumentId"
          },
          "project_id": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentId": {
        "type": "string",
        "format": "uuid",
        "description": "設計書 1 冊（ファイル 1 つ）。"
      },
      "DocumentListResponse": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "doc_type",
          "sheet_count",
          "page_count",
          "chunk_count",
          "parse_status",
          "updated_at"
        ],
        "properties": {
          "business_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "chunk_count": {
            "type": "integer",
            "format": "int64"
          },
          "current_revision_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RevisionId"
              }
            ]
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "id": {
            "$ref": "#/components/schemas/DocumentId"
          },
          "page_count": {
            "type": "integer",
            "format": "int64"
          },
          "parse_status": {
            "type": "string"
          },
          "sheet_count": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EvidenceId": {
        "type": "string",
        "format": "uuid",
        "description": "証拠。"
      },
      "EvidenceResponse": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_type",
          "locator",
          "quote",
          "quote_hash",
          "context_before",
          "context_after",
          "resolution",
          "confidence"
        ],
        "properties": {
          "confidence": {
            "type": "number",
            "format": "float"
          },
          "context_after": {
            "type": "string"
          },
          "context_before": {
            "type": "string"
          },
          "document_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DocumentId"
              }
            ]
          },
          "document_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_id": {
            "$ref": "#/components/schemas/EvidenceId"
          },
          "locator": {},
          "mime_type": {
            "type": [
