[Unit]
Description=Systivra audit log forwarder
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=systivra
WorkingDirectory=/opt/systivra
EnvironmentFile=/etc/systivra/audit-forward.env
ExecStart=/usr/bin/python3 /opt/systivra/scripts/audit-forward.py --once
Nice=10
