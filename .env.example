# 開発用。コピーして .env にする（.env は git 管理外）。
# docker compose はこのファイルを読まない。compose は docker-compose.yml の
# environment を使う。ここは「cargo run で直接動かすとき」用。

DATABASE_URL=postgres://systivra_app@localhost:5432/systivra
PORT=18080
PUBLIC_BASE_URL=http://127.0.0.1:18080
SYSTIVRA_DATA_DIR=./data

# Phase 4 Git。既定はローカル / file:// パスだけを許可する。
# 閉域の HTTP(S) / SSH / git:// remote を使う場合だけ 1 にする。
# GIT_ALLOW_REMOTE=1

# worker は別ロール（API と同じロールにしない）。roles.sql の 3 ロール構成。
# DATABASE_URL=postgres://systivra_scheduler@localhost:5432/systivra
#
# ── Azure Database for PostgreSQL を使う場合 ──
# TLS 必須なので sslmode=require を明示する（未指定は prefer で平文にフォールバック
# しうる）。管理者のログイン名は <admin>@<server> 形式。
# 詳細は deployment/azure/README.md（拡張の許可リスト・PITR・接続プールの注意）。
# DATABASE_URL=postgres://systivra_app@my-pg-server.postgres.database.azure.com:5432/systivra?sslmode=require
# 証明書まで検証する場合: ...&sslrootcert=/etc/ssl/certs/baltimore.pem

# 32 バイト以上のランダム文字列。**短いと Cookie を偽造される。**
#   openssl rand -hex 32
SESSION_SECRET=

# https でない開発環境では false。本番は必ず true（既定）。
SESSION_COOKIE_SECURE=false

RUST_LOG=info,systivra_api=debug

# Phase 3 のグラフ投影。未設定なら bolt://localhost:7687 / neo4j / neo4j。
# Neo4j を使わない場合は NEO4J_DISABLED=1（PG のグラフ API はそのまま動く）。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# Phase 5 PDF 帳票の日本語フォント（TTF / OTF）。未設定時は既知の OS フォントを探索し、
# 見つからなければ report.pdf は CAPABILITY_UNSUPPORTED を返す。
# SYSTIVRA_PDF_FONT=/path/to/NotoSansJP-Regular.ttf

# Phase 7 の AI。AI_BASE_URL が未設定なら DisabledAiProvider になり、
# Agent / Workflow は AI_UNAVAILABLE で閉じる（中核機能は動く）。
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=
# AI_MODEL_FAST=
# AI_MODEL_REASONING=
# AI_MODEL_LONG_CONTEXT=

# worker のポーリング間隔と stale 判定（既定は 1 秒 / 300 秒）。
# WORKER_TICK_SEC=1
# WORKER_STALE_SEC=300

# Phase 8 の認証レート制限。対象は login / oidc start / oidc callback。
# AUTH_RATE_LIMIT_CAPACITY=10
# AUTH_RATE_LIMIT_REFILL_PER_MIN=10
# 前段のリバースプロキシが X-Forwarded-For を上書きする場合だけ 1。
# TRUST_PROXY=1

# Phase 8 の OIDC SSO。OIDC_* を 1 つも設定しなければパスワードログインのみ。
# 一部だけ設定すると API は起動に失敗する（SSO 有効のつもりで無効のまま動く事故を防ぐ）。
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=systivra
# OIDC_CLIENT_SECRET=
# 未設定なら PUBLIC_BASE_URL + /api/v1/auth/oidc/callback。
# OIDC_REDIRECT_URI=http://localhost:15173/api/v1/auth/oidc/callback
# OIDC_PROVIDER_LABEL=SSO
# OIDC_SCOPES=openid email profile
# SCIM を有効にする場合。未設定なら /scim/v2 は 404。
# SCIM_BEARER_TOKEN=
# 無操作で失効させるまでの分。0 または未設定なら無効。
# SESSION_IDLE_MINUTES=60

# バックアップ（scripts/backup.sh）。鍵は Secrets から渡す。
# BACKUP_ENCRYPTION_KEY=
# BACKUP_RETENTION_DAYS=30
# BACKUP_UPLOAD_CMD=

# 監査の SIEM 転送（scripts/audit-forward.py）。
# AUDIT_WEBHOOK_URL=
# AUDIT_WEBHOOK_SECRET=

# 従量課金の単価（USD / 100 万トークン）。未設定ならコスト上限は判定しない
# （0 ドルではなく「判定不能」として cost.priced=false を返す）。
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=

# 承認待ちの有効期限（秒）。既定 86400（24 時間）。worker が期限切れを EXPIRED にする。
# APPROVAL_TTL_SEC=86400
