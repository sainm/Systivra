    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ui:phase2": "node scripts/ui-check-phase2.mjs",
    "check:ui:phase2-revisions": "node scripts/ui-check-phase2-revisions.mjs",
    "check:ui:phase3": "node scripts/ui-check-phase3.mjs",
    "check:ui:phase3-ops": "node scripts/ui-check-phase3-ops.mjs",
    "check:ui:phase4": "node scripts/ui-check-phase4.mjs",
    "check:ui:phase5": "node scripts/ui-check-phase5.mjs",
    "check:ui:phase6": "node scripts/ui-check-phase6.mjs",
    "check:ui:phase7": "node scripts/ui-check-phase7.mjs",
    "check:ui:phase7-inquiry": "node scripts/ui-check-phase7-inquiry.mjs",
    "check:ui:phase7-mcp": "node scripts/ui-check-phase7-mcp.mjs",
    "check:ui:phase8": "node scripts/ui-check-phase8.mjs",
    "check:ui:phase5-inquiry": "node scripts/ui-check-phase5-inquiry.mjs",
